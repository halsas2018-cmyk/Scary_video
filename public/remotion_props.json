      "start": 25.736,
      "end": 29.258
    },
    {
      "sentence": "There was no corpse inside, only a small, vintage tape recorder sitting on a ledge.",
      "search_term": "vintage tape recorder",
      "media_type": "photo",
      "visual": "An old dusty vintage cassette recorder sitting in a dark space.",
      "asset_path": "project_assets/shot_8.jpg",
      "duration_seconds": 4.123,
      "start": 29.639,
      "end": 33.762
    },
    {
      "sentence": "I reached in, my fingers trembling as I pressed the stop button.",
      "search_term": "hand reaching dark",
