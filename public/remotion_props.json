{
  "shots": [
    {
      "sentence": "Every night at three, the rhythmic scratching inside my bedroom wall wakes me up.",
      "search_term": "person lying awake",
      "media_type": "video",
      "visual": "A person lying in a dark bedroom looking wide awake at the wall.",
      "asset_path": "project_assets/shot_1.mp4",
      "duration_seconds": 4.064,
      "start": 0.191,
      "end": 4.255
    },
    {
      "sentence": "I used to think it was just rats, but rats don't hum lullabies in my mother's voice.",
      "search_term": "scared person face",
      "media_type": "video",
      "visual": "A close up of a person looking confused and distressed in the dark.",
      "asset_path": "project_assets/shot_2.mp4",
      "duration_seconds": 3.843,
      "start": 4.676,
      "end": 8.519
    },
    {
      "sentence": "I pressed my ear against the cold plaster, shivering as the muffled singing grew louder.",
      "search_term": "person listening wall",
      "media_type": "video",
      "visual": "A person pressing their ear against a textured wall in a dimly lit room.",
      "asset_path": "project_assets/shot_3.mp4",
      "duration_seconds": 4.424,
      "start": 9.0,
      "end": 13.424
    },
    {
      "sentence": "It sounded like she was whispering my name, pleading for me to let her out.",
      "search_term": "dark empty hallway",
      "media_type": "video",
      "visual": "A dark, empty hallway with shadows cast on the wall.",
      "asset_path": "project_assets/shot_4.mp4",
      "duration_seconds": 3.323,
      "start": 13.825,
      "end": 17.148
    },
    {
      "sentence": "My mother has been buried in the churchyard for over a decade.",
      "search_term": "old cemetery tombstone",
      "media_type": "photo",
      "visual": "A weathered tombstone in an old, foggy cemetery.",
      "asset_path": "project_assets/shot_5.jpg",
      "duration_seconds": 2.823,
      "start": 17.588,
      "end": 20.411
    },
    {
      "sentence": "I grabbed a heavy hammer, driven by a mixture of grief and pure, primal terror.",
      "search_term": "hand holding hammer",
      "media_type": "video",
      "visual": "A person's hand firmly gripping a heavy metal hammer.",
      "asset_path": "project_assets/shot_6.mp4",
      "duration_seconds": 4.463,
      "start": 20.872,
      "end": 25.335
    },
    {
      "sentence": "With a single, desperate swing, I shattered the drywall near the floorboard.",
      "search_term": "breaking wall hole",
