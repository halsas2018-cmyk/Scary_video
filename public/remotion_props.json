{
  "shots": [
    {
      "sentence": "The hallway lights sputtered as a lone gurney rolled down the empty wing.",
      "search_term": "hospital hallway flickering",
      "media_type": "video",
      "visual": "Dim hospital hallway with flickering fluorescent lights as a solitary gurney slowly rolls down the empty corridor.",
      "asset_path": "project_assets/shot_1.mp4",
      "duration_seconds": 3.263,
      "start": 0.111,
      "end": 3.374
    },
    {
      "sentence": "A cold breath brushed my neck, and the stretcher\u2019s tag read 'Emily'.",
      "search_term": "cold breath neck",
      "media_type": "video",
      "visual": "A visible breath of cold air passes over a neck while the camera focuses on a gurney tag that reads \"Emily\".",
      "asset_path": "project_assets/shot_2.mp4",
      "duration_seconds": 3.403,
      "start": 3.794,
      "end": 7.197
    },
    {
      "sentence": "My own name, though my shift ended hours ago and my badge still lay on the station.",
      "search_term": "nurse badge on desk",
      "media_type": "photo",
      "visual": "Close\u2011up of a nurse\u2019s badge with a name label sitting on a metal station desk.",
      "asset_path": "project_assets/shot_3.jpg",
